# — Contract deploy —
BASE_SEPOLIA_RPC=https://base-sepolia.g.alchemy.com/v2/YOUR_KEY
BASE_RPC=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
PRIVATE_KEY=0x...
ETHERSCAN_API_KEY=...
# USDC per network (override in networks.json)
# Base Sepolia: 0x036CbD53842c5426634e7929541eC2318f3dCF7e (Circle faucet)
# Base Mainnet: 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
TREASURY_ADDRESS=0x... # owner-provided, defaults to deployer if unset in script
FEE_BPS=500

# — Frontend (Vercel) —
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_BASE_SEPOLIA_CONTRACT=0x...
NEXT_PUBLIC_BASE_CONTRACT=0x...
NEXT_PUBLIC_RELAY_API_KEY= # optional, for revenue share
NEXT_PUBLIC_CHAIN=baseSepolia # or base
NEXT_PUBLIC_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY # or base-sepolia for testnet
DATABASE_URL=postgresql://user:pass@host:5432/opentip?sslmode=require
GITHUB_ID=
GITHUB_SECRET=
NEXTAUTH_SECRET= # openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
START_BLOCK=51481885 # contract deployment block for dev profile scanning

# — Indexer (Azure Container Apps) —
# reuses DATABASE_URL
RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
CONTRACT_ADDRESS=0x...
START_BLOCK=0
GETLOGS_RANGE=2000 # Alchemy free tier: max 10. PAYG: up to 2000.
